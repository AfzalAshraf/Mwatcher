# Secrets for the Mwatcher bridge (services/mwatcher-bridge.service).
#
#   cp config/bridge.env.example ~/.config/mwatcher/bridge.env
#   chmod 600 ~/.config/mwatcher/bridge.env      # it holds your access key
#
# This must be the SAME key Fast Combo uses (FC_ACCESS_KEY in fastcombo.env) --
# it is the secret part of your addon link.

FASTCOMBO_ACCESS_KEY=change-me-12-random-chars

# Optional: a profile token, if you installed Fast Combo in Stremio with a
# personalised link of the form /<key>/<token>/manifest.json. Leave empty otherwise.
#FASTCOMBO_TOKEN=
