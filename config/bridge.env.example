# Secrets for the Mwatcher bridge (services/mwatcher-bridge.service).
#
#   cp config/bridge.env.example ~/.config/mwatcher/bridge.env
#   chmod 600 ~/.config/mwatcher/bridge.env      # it holds your access key
#
# This must be the SAME key Fast Combo uses (FC_ACCESS_KEY in fastcombo.env) --
# it is the secret part of your addon link.

FASTCOMBO_ACCESS_KEY=change-me-12-random-chars

# Optional: a profile token, if you installed Fast Combo in Stremio with a
# personalised link of the form /<key>/<token>/manifest.json. Leave empty otherwise.
#FASTCOMBO_TOKEN=

# --- Seerr: request a title and your own server downloads it (no debrid) -------------
# Set up the whole stack with:  sudo bash install.sh seerr
# Seerr hands requests to Radarr/Sonarr, which use Prowlarr + qBittorrent to put real
# files in your library. Nothing here downloads via the bridge.
#
# SEERR_MODE:
#   off      never contact Seerr (default)
#   request  only create a Seerr request -- the bridge downloads nothing
#   both     create the request AND stream now, so you can watch immediately while
#            the permanent copy is fetched in the background
#SEERR_MODE=off
#SEERR_URL=http://127.0.0.1:5055
# WARNING: Seerr's API key is an ADMIN credential -- anyone holding it can change your
# server settings. Keep this file chmod 600 and never put the key in a web page.
#SEERR_API_KEY=
#SEERR_IS4K=0
#SEERR_TV_SEASONS=all

# --- download validation (stops Plex "s1001" errors from bad files) ------------------
# A host that serves an HTML error page instead of a video is rejected before it enters
# the library, and the next-best stream is tried automatically.
#TELESTREAM_MIN_BYTES=20971520
#TELESTREAM_MIN_DURATION=30
#TELESTREAM_VERIFY_MEDIA=1

# --- play-through: add titles WITHOUT downloading them --------------------------------
# action=strm (or TELESTREAM_ACTION=strm to make it the default) writes a tiny .strm into
# the library. When Plex plays it the bridge scrapes a FRESH link at that moment, streams
# it through with the right headers (Range-aware, so seeking works) and keeps a capped
# cache that evicts oldest-first. Nothing is downloaded up front.
#
# PUBLIC_BASE_URL is the address written into the .strm and MUST be reachable from your
# Plex clients (phone/TV), not from this server. Unset = your LAN IP. Loopback = s1001 on
# every other device. Away from home, use your tunnel/Tailscale URL instead.
#
# BRIDGE_HOST is the other half of it and the one people miss: the bridge has to LISTEN on
# that address. The systemd unit sets BRIDGE_HOST=127.0.0.1, and this file is read by
# EnvironmentFile= AFTER that, so setting it here overrides the unit and survives the unit
# being rewritten. Leave it loopback with play-through on and every .strm plays on the
# server itself and gives s1001 on every phone and TV. install.sh sets both automatically
# when it sees TELESTREAM_ACTION=strm; keep the port LAN-only in the firewall, because
# /play/<key> has no authentication.
#BRIDGE_HOST=0.0.0.0
#TELESTREAM_ACTION=stream
#TELESTREAM_PUBLIC_BASE_URL=http://192.168.0.200:8889
#TELESTREAM_CACHE_DIR=~/media/cache
#TELESTREAM_CACHE_MAX_GB=20
#TELESTREAM_RESOLVE_TTL=300
# The play-through table is persisted here so your .strm files survive a restart or a reboot.
#TELESTREAM_PLAY_FILE=~/.local/share/mwatcher/plays.json
