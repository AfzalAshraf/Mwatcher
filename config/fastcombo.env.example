# Secrets + settings for Fast Combo (services/fastcombo.service).
#
#   cp config/fastcombo.env.example ~/.config/mwatcher/fastcombo.env
#   chmod 600 ~/.config/mwatcher/fastcombo.env      # it holds secrets
#
# Generate the key and password with something like:
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 16; echo

# The secret part of your addon link. Strangers who guess it can use your server.
FC_ACCESS_KEY=change-me-12-random-chars

# Password for the control panel at http://127.0.0.1:7000/<FC_ACCESS_KEY>/configure
FC_ADMIN_PASSWORD=change-me-too

# Optional: addons to start with, manifest links separated by commas.
# You can also add them later on the control panel (that is the normal way).
#FC_UPSTREAMS=https://example.com/addon1/manifest.json,https://example.com/addon2/manifest.json

# Optional: the HTTPS address Stremio apps should use, when Fast Combo sits behind a
# reverse proxy / Cloudflare Tunnel. Leave unset for bridge-only use on localhost.
#FC_PUBLIC_URL=https://addons.example.com

# Optional tuning (defaults shown):
#FC_MAX_ADDONS=50            # Node/VPS can do 50
#FC_PROBE_TIMEOUT_MS=3000    # a link slower to start than this counts as "slow"
#FC_CACHE_MINUTES=15
#FC_FRESH_SECONDS=120
